{
  "version": "2.0.0",

  "tasks": [

    // ============================================================
    // 1. BUILD THE ENTIRE SOLUTION
    // ============================================================

    {
      "label": "🔨 Build MyGateApp Solution",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/MyGateApp.slnx"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      }
    },

    // ============================================================
    // 2. START ALL SERVICES
    // ============================================================

    {
      "label": "▶ Start MyGate Services",
      "dependsOn": [
        "Identity (5103)",
        "Tenant (5104)",
        "Visitor (5105)",
        "Billing (5107)",
        "Helpdesk (5108)",
        "Notice (5109)",
        "Amenity (5110)",
        "DailyHelp (5111)",
        "Vehicle (5112)",
        "Directory (5113)",
        "Emergency (5114)",
        "RealtimeGateway (5116)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },

    // ============================================================
    // 3. MASTER TASK
    // ============================================================

    {
      "label": "🚀 START ALL MyGate",
      "dependsOn": [
        "🔨 Build MyGateApp Solution",
        "▶ Start MyGate Services"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },

